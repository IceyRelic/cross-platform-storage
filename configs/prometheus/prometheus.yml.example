global:
  scrape_interval: 15s
  evaluation_interval: 15s

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - 127.0.0.1:9093

rule_files:
  - /etc/prometheus/rules/*.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - 127.0.0.1:9090
        labels:
          role: monitor

  - job_name: node
    static_configs:
      - targets:
          - 192.0.2.40:9100   # monitor-01
          - 192.0.2.10:9100   # stor-svc-01
          - 192.0.2.20:9100   # stor-svc-02
          - 192.0.2.30:9100   # backup-01
          - 192.0.2.50:9100   # client-linux-01
        labels:
          env: lab
          project: storage-platform

  - job_name: process
    static_configs:
      - targets:
          - 192.0.2.40:9256
          - 192.0.2.10:9256
          - 192.0.2.20:9256
          - 192.0.2.30:9256
        labels:
          env: lab
          project: storage-platform
